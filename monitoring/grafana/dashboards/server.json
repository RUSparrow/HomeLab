    {
      "id": 14,
      "type": "timeseries",
      "title": "Трафик сервера (сетевая карта eno1) и доля VPN",
      "description": "Сетевая карта eno1 — весь трафик сервера: интернет, домашняя сеть и VPN вместе. Входящий — данные, пришедшие в сервер, исходящий — ушедшие из него. Это текущая нагрузка, а не скорость интернета (её никто не замеряет). VPN — часть общего трафика: то, что прошло через AmneziaWG от твоих устройств и к ним. Исходящий показан вниз от нуля.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfx33msjmzjlsa"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "rate(node_network_receive_bytes_total{device=\"eno1\",instance=\"node-exporter:9100\"}[$__rate_interval])",
          "legendFormat": "Весь ↓ в сервер",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "-rate(node_network_transmit_bytes_total{device=\"eno1\",instance=\"node-exporter:9100\"}[$__rate_interval])",
          "legendFormat": "Весь ↑ из сервера",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "sum(rate(homelab_vpn_peer_received_bytes[$__rate_interval]))",
          "legendFormat": "VPN ↓ от клиентов",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "-sum(rate(homelab_vpn_peer_sent_bytes[$__rate_interval]))",
          "legendFormat": "VPN ↑ клиентам",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 120000,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
