    {
      "id": 10,
      "type": "timeseries",
      "title": "Загрузка процессора",
      "description": "Сколько процентов процессора занято. iowait — процессор ждёт диски.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfx33msjmzjlsa"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",instance=\"node-exporter:9100\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "Всего",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{job=\"node\",instance=\"node-exporter:9100\",mode=~\"iowait|system\"}[$__rate_interval])) / scalar(count(node_cpu_seconds_total{job=\"node\",instance=\"node-exporter:9100\",mode=\"idle\"}))",
          "legendFormat": "{{mode}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 120000,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "iowait"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ожидание диска (iowait)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "system"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ядро системы"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
