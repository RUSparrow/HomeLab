  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Процессор по контейнерам",
      "description": "100% = одно ядро целиком. У сервера 8 потоков, максимум 800%.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfx33msjmzjlsa"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\",name!~\"cadvisor\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 120000,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
