          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "max by (name) (label_replace(homelab_container_restarts, \"name\", \"$1\", \"container\", \"(.*)\"))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
