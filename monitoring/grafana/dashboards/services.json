    {
      "id": 3,
      "type": "timeseries",
      "title": "Трафик VPN по клиентам",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfx33msjmzjlsa"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "sum by (peer) (rate(homelab_vpn_peer_sent_bytes[$__rate_interval]) + rate(homelab_vpn_peer_received_bytes[$__rate_interval])) > 0",
          "legendFormat": "{{peer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 120000,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fail2ban: неудачные входы по SSH",
      "description": "Боты из интернета перебирают пароли. Каждый столбик — 15 минут.",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfx33msjmzjlsa"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfx33msjmzjlsa"
          },
          "expr": "sum(increase(f2b_jail_failed_total{jail=\"sshd\"}[$__interval]))",
          "legendFormat": "Попытки",
          "refId": "A",
          "interval": "15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 120000,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
