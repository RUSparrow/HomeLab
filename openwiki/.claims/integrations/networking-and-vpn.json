  "claims": [
    {
      "id": "claim_4c781b710d06459dafc5e8a2d867d60f",
      "statement": "The vpn Compose project runs a DuckDNS updater and a WireGuard server; DuckDNS uses the configured subdomain and persists under ./duckdns, while WireGuard advertises the DuckDNS hostname, listens on UDP 51820, requests seven peers on 10.13.13.0/24, and persists its configuration under ./wireguard.",
      "evidence": [
        {
          "resource": "repo://vpn/docker-compose.yml#L1-L34",
          "version": "repo-lines-v1:sha256:f9280a4bf9c3676be4bf32ea297a4d79c4532e41775746cba09dc21387ea099e:"
        }
      ]
    },
    {
      "id": "claim_2cf4c3e6473c44d8af1d4dd69470555c",
      "statement": "The declared Internet-facing WireGuard boundary is the container's published UDP mapping 51820:51820/udp; the repository does not declare upstream router or firewall forwarding.",
      "evidence": [
        {
          "resource": "repo://vpn/docker-compose.yml#L15-L34",
          "version": "repo-lines-v1:sha256:b3b1eef78f578e756e756b9ecb3ea3e8f9470e14d0f6bd6f76c4c5ccc70fb7c6:"
        }
      ]
    },
    {
      "id": "claim_6a2a098619a845449162106e5491367a",
      "statement": "The WireGuard server template assigns the server interface address from the interface prefix with a .1 suffix, listens on port 51820, and adds/removes forwarding and eth+ masquerade rules on interface up/down.",
